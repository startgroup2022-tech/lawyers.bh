# Environment Configuration for Lawyers.bh
# Copy this file to .env and fill in the actual values

# API Configuration
BASE_URL=https://api.lawyers.bh/v1
WS_URL=wss://api.lawyers.bh/ws

# App Configuration
APP_NAME=محامون البحرين
APP_PACKAGE=com.lawyersbh.app
APP_BUNDLE_ID=com.lawyersbh.app

# Feature Flags
ENABLE_BIOMETRIC=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# Third Party Services
GOOGLE_CLIENT_ID=your-google-client-id
APPLE_CLIENT_ID=your-apple-client-id
FIREBASE_PROJECT_ID=your-firebase-project-id

# Payment Gateways
BENEFITPAY_MERCHANT_ID=your-merchant-id
BENEFITPAY_SECRET_KEY=your-secret-key

# Storage
ENCRYPTION_KEY=your-32-char-encryption-key

# Analytics
MIXPANEL_TOKEN=your-mixpanel-token
AMPLITUDE_API_KEY=your-amplitude-key