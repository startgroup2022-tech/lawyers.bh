# Staging Environment
BASE_URL=https://staging-api.lawyers.bh/v1
WS_URL=wss://staging-api.lawyers.bh/ws
APP_NAME=محامون البحرين (Staging)
APP_PACKAGE=com.lawyersbh.app.staging
APP_BUNDLE_ID=com.lawyersbh.app.staging
ENABLE_BIOMETRIC=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
GOOGLE_CLIENT_ID=staging-google-client-id
APPLE_CLIENT_ID=staging-apple-client-id
FIREBASE_PROJECT_ID=lawyers-bh-staging
BENEFITPAY_MERCHANT_ID=staging-merchant-id
BENEFITPAY_SECRET_KEY=staging-secret-key
ENCRYPTION_KEY=staging-encryption-key-32-chars!!
MIXPANEL_TOKEN=staging-mixpanel-token
AMPLITUDE_API_KEY=staging-amplitude-key